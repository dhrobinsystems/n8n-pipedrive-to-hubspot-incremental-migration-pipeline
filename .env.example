# =============================================================================
# n8n-pipedrive-to-hubspot-incremental-migration-pipeline :: environment template
# -----------------------------------------------------------------------------
# Copy to .env (git-ignored) or set in your n8n host / container / secret
# manager. Every value below is a PLACEHOLDER. Never commit real tokens.
#
# SAFE BY DEFAULT: leaving this file untouched keeps the workflow in
# SANDBOX_MODE: synthetic fixture, zero network calls, nothing written.
#
# Full text: DISCLAIMER.md · Licensed under the MIT License. License: MIT © 2026 dhRobin Systems · Provided as-is, see the disclaimer.
# =============================================================================

# ---- n8n runtime --------------------------------------------------------------
# Required so {{ $env.X }} works. If env access is blocked the workflow stays in
# sandbox mode instead of failing open.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
GENERIC_TIMEZONE=UTC

# ---- Safety switches (safe defaults shown) ----------------------------------
# Safe-ON: turn off only with an explicit false/0/no/off.
SANDBOX_MODE=true
DRY_RUN=true
ASSOCIATIONS_ENABLED=true
# Safe-OFF: turn on only with an explicit true/1/yes/on.
HUBSPOT_WRITES_ENABLED=false
# Ignore watermarks and content hashes; re-extract from MIGRATION_START_DATE (idempotent).
FULL_RESYNC=false
# Replace corrupt migration state with a fresh one (one run only, then set back to false).
STATE_RESET=false

# ---- Credentials (placeholders; read only by the HTTP node headers) ----------
# Pipedrive: Settings -> Personal preferences -> API. Sent as the x-api-token header.
PIPEDRIVE_API_TOKEN=your_pipedrive_api_token_here
# HubSpot private app token (see README for scopes). Sent as a Bearer token.
HUBSPOT_PRIVATE_APP_TOKEN=your_hubspot_private_app_token_here

# ---- Endpoints (host allowlisted; no paths or credentials) --------------------
PIPEDRIVE_API_BASE_URL=https://api.pipedrive.com
PIPEDRIVE_ALLOWED_HOSTS=api.pipedrive.com,.pipedrive.com
HUBSPOT_API_BASE_URL=https://api.hubapi.com
HUBSPOT_ALLOWED_HOSTS=api.hubapi.com,api-eu1.hubapi.com

# ---- Scope ------------------------------------------------------------------------
# Comma-separated subset of organizations,persons,deals,activities (always run in that order).
ENTITIES=organizations,persons,deals,activities
# RFC3339 UTC. First run extracts everything updated since this date.
MIGRATION_START_DATE=2000-01-01T00:00:00Z
# Deal statuses to migrate (open, won, lost). Deleted deals are never migrated.
DEAL_STATUSES=open,won,lost

# ---- Batching ---------------------------------------------------------------------
# Pipedrive v2 page size (max 500) and page cap per entity per run (backlog continues next run).
PIPEDRIVE_PAGE_SIZE=500
PIPEDRIVE_MAX_PAGES_PER_ENTITY=20
# HubSpot batch size for reads / upserts (max 100) and for associations.
BATCH_SIZE=100
ASSOCIATION_BATCH_SIZE=100

# ---- Guards (writes are blocked when exceeded) ---------------------------------------
MAX_WRITES_PER_RUN=5000
MAX_QUARANTINE_PCT=25
MAX_PENDING_ASSOCIATIONS=10000

# ---- HubSpot unique ID properties (create them first; see README) ---------------------
HS_ORG_ID_PROPERTY=pipedrive_org_id
HS_PERSON_ID_PROPERTY=pipedrive_person_id
HS_DEAL_ID_PROPERTY=pipedrive_deal_id
HS_ACTIVITY_ID_PROPERTY=pipedrive_activity_id

# ---- Mapping tables (placeholder ids; replace with your own) -------------------------
# Pipedrive user id -> HubSpot owner id. Unmapped owners are left blank (warning).
OWNER_MAP_JSON={"1000001":"2000001"}
# Pipedrive stage id (or "won" / "lost") -> HubSpot pipeline + deal stage internal names.
# Deals with an unmapped stage are QUARANTINED unless DEFAULT_DEAL_PIPELINE/STAGE are set.
STAGE_MAP_JSON={"1":{"pipeline":"default","dealstage":"appointmentscheduled"},"won":{"pipeline":"default","dealstage":"closedwon"},"lost":{"pipeline":"default","dealstage":"closedlost"}}
DEFAULT_DEAL_PIPELINE=
DEFAULT_DEAL_STAGE=
# Pipedrive activity type -> calls | meetings | tasks (merged with built-in defaults).
ACTIVITY_TYPE_MAP_JSON={}
# Optional Pipedrive organization custom field key that holds the website / domain.
PIPEDRIVE_ORG_DOMAIN_FIELD=
# Map Pipedrive deal currency to deal_currency_code (needs multi-currency in HubSpot).
MAP_DEAL_CURRENCY=false
# quarantine | strip_email | adopt  (when a contact email already exists in HubSpot)
CONTACT_EMAIL_CONFLICT_POLICY=quarantine

# ---- Testing ------------------------------------------------------------------------------
# Pins "now" (ISO 8601) for reproducible runs.
NOW_OVERRIDE=

